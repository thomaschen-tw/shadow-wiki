# ── Credentials & secrets ─────────────────────────────────────────────────────
# The real .env with API keys — NEVER commit this
.env
# Any .env variants (.env.local, .env.production, .env.staging, etc.)
.env.*
# Keep the template — it has no real keys
!.env.example

# ── Python runtime ────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# ── Test artefacts ────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── PulseWiki runtime data (generated at runtime, not source) ───────────────
db/
raw/

# ── Claude Code project settings ──────────────────────────────────────────────
# settings.local.json may contain hooks with sensitive commands or paths
# plans/ and specs/ are internal design artefacts
.claude/

# ── Internal superpowers planning docs ────────────────────────────────────────
docs/superpowers/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble

# ── Obsidian local vault UI state (not project source) ────────────────────────
.obsidian/

# ── IDE / editor local state ──────────────────────────────────────────────────
.cursor/

# ── wiki/ contains LLM-generated output — commit intentionally as living docs ─
# (not gitignored — commit wiki/*.md for demo samples and shared knowledge)
