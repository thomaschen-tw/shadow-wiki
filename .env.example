# PulseWiki reads ALL settings from this file (see scripts/config.py).
# Change model names here only — do not edit Python defaults for day-to-day use.
# Verify: uv run python scripts/resource_mgr.py llm

# ── LLM Backend Selection ──────────────────────────────────
# Local backend (high-frequency tasks): auto | lmstudio | ollama
# auto = probe LM Studio first, fall back to Ollama
LOCAL_LLM_BACKEND=auto

# Cloud backend (quality-critical tasks): claude | qwen_cloud | deepseek
CLOUD_LLM_BACKEND=claude

# false = all tasks use local LLM; true = cloud for new wiki pages (CREATE_PAGE/SYNTHESIZE)
USE_CLOUD_LLM=false

# LLM request timeout in seconds (default: 300)
LLM_TIMEOUT=300

# Disable Qwen3 thinking mode — set false for faster automated pipeline responses
ENABLE_THINKING=false

# ── Local LLM ─────────────────────────────────────────────
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Must match the model id shown in LM Studio (Developer → /v1/models)
LMSTUDIO_MODEL=qwen/qwen3.6-27b

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.6:27b

# ── Cloud LLM ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

DASHSCOPE_API_KEY=sk-...
QWEN_CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CLOUD_MODEL=qwen-plus

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── GitHub ────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_REPO=owner/repo
GITHUB_WEBHOOK_SECRET=your-secret

# ── Slack ─────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNELS=C12345,C67890

# ── Local Scan ────────────────────────────────────────────
LOCAL_SCAN_PATHS=./src,./docs
LOCAL_SCAN_EXTENSIONS=.py,.ts,.tsx,.md,.go

# ── Database ──────────────────────────────────────────────
# true = local SQLite at DB_PATH (default); false = use DATABASE_URL
USE_LOCAL_DB=true
DATABASE_URL=

# ── Knowledge Base ────────────────────────────────────────
# Point to your Obsidian vault's wiki subfolder
KNOWLEDGE_BASE_PATH=/path/to/your/obsidian/vault/wiki
# Similarity threshold: skip LLM if >85% of tokens already seen (0.0–1.0)
KNOWLEDGE_BASE_SIMILARITY_THRESHOLD=0.85

# ── System ────────────────────────────────────────────────
WIKI_DIR=./wiki
DB_PATH=./db/shadow.db
RAW_DIR=./raw
